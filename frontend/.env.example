# Copy to .env.local for local overrides. All Vite env vars exposed to the
# browser must be prefixed VITE_ - never put a real secret in one of these,
# since anything here ships in the built JS bundle.

# Frontend error tracking (Sentry). Leave unset to disable - see
# src/monitoring.ts. Safe to expose in the client bundle (it's a public
# ingest key, not a secret).
# VITE_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
