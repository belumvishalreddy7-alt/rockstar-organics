# Copy this file to .env and adjust values before running the backend.
# Never commit a real .env file.

ENVIRONMENT=development
SECRET_KEY=change-me-to-a-long-random-value

# Local development default (SQLite). For production, use PostgreSQL:
# DATABASE_URL=postgresql+psycopg2://rso_user:rso_password@localhost:5432/rockstar_organics
DATABASE_URL=sqlite:///./rockstar_organics.db

SESSION_COOKIE_NAME=rso_session
SESSION_MAX_AGE_SECONDS=604800
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

UPLOAD_ROOT=./uploads
MAX_IMAGE_SIZE_BYTES=5242880
MAX_DOCUMENT_SIZE_BYTES=10485760

LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
PUBLIC_FORM_RATE_LIMIT_ATTEMPTS=10
PUBLIC_FORM_RATE_LIMIT_WINDOW_SECONDS=600

PASSWORD_RESET_TOKEN_TTL_MINUTES=60
# MUST be false in production.
DEV_EXPOSE_RESET_TOKEN=true

# OTP-gated signup (POST /api/auth/signup -> POST /api/auth/verify-otp).
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
# MUST be false in production - same rule as DEV_EXPOSE_RESET_TOKEN.
DEV_EXPOSE_OTP=true

# External notification providers. Leave false until a real provider is
# wired up in app/core/notify.py; the app never fakes a delivered
# notification for a disabled channel.
EMAIL_PROVIDER_ENABLED=false
SMS_PROVIDER_ENABLED=false
WHATSAPP_PROVIDER_ENABLED=false

# Real transactional email via Brevo (see app/core/email.py). Setting
# BREVO_API_KEY, EMAIL_PROVIDER_ENABLED=true, and EMAIL_FROM_EMAIL makes
# signup-OTP, password-reset, welcome, and dealer/distributor approval
# emails actually send - this is a genuine HTTP integration, not a mock.
# IMPORTANT: EMAIL_FROM_EMAIL must be verified as a sender in the Brevo
# dashboard (Settings -> Senders) first - there is no sandbox fallback,
# an unverified sender is rejected outright.
# BREVO_API_KEY=xkeysib-your_real_key_here
EMAIL_FROM_NAME=Rockstar Organics
# EMAIL_FROM_EMAIL=you@example.com
PUBLIC_APP_URL=http://localhost:5173

DEALER_AVAILABILITY_STALE_DAYS=14

# Shared rate limiting across worker processes/instances. Leave unset for
# local development (falls back to an in-memory limiter with a startup
# warning logged); a multi-worker/multi-instance production deployment
# MUST set this or rate limits will under-count.
# REDIS_URL=redis://localhost:6379/0

# Error tracking (Sentry). Leave unset to disable - no client is
# initialized and nothing is silently "sent" for a disabled channel, same
# as the notification providers above.
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
SENTRY_TRACES_SAMPLE_RATE=0.1

# Prometheus /metrics endpoint. Only mount this behind network-level
# access control (a private ingress, a scraper-only security group) -
# it is unauthenticated at the application layer.
METRICS_ENABLED=false
